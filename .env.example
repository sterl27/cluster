# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=cluster_db
DB_SSL=false

# Cache (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# API Configuration
API_VERSION=v1
API_PREFIX=/api

# gRPC
GRPC_PORT=50051
GRPC_HOST=0.0.0.0

# Security
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION=24h

# External Services
SERVICE_TIMEOUT=30000
MAX_RETRIES=3
