{
  "name": "cluster",
  "version": "0.1.0",
  "description": "High-performance, modular backend architecture",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts",
    "docker:build": "docker build -f docker/Dockerfile -t cluster:latest .",
    "docker:run": "docker run -p 3000:3000 cluster:latest"
  },
  "dependencies": {
    "express": "^4.18.2",
    "redis": "^4.6.0",
    "pg": "^8.10.0",
    "grpc": "^1.24.11",
    "dotenv": "^16.0.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/express": "^4.17.17",
    "typescript": "^5.0.0",
    "ts-node": "^10.9.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "eslint": "^8.40.0"
  }
}
